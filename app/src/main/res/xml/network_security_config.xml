<?xml version="1.0" encoding="utf-8"?>
<!-- Android 7 (API 24/25) does not trust Let's Encrypt's ISRG roots, which Open-Meteo and
     Wikimedia use. Bundle them next to the system store; no cleartext, no user CAs. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/isrg_root_x1" />
            <certificates src="@raw/isrg_root_x2" />
        </trust-anchors>
    </base-config></network-security-config>
