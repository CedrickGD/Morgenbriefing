<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Compose draws everything; the window theme only needs the right background
         so there is no flash before the first frame. -->
    <style name="Theme.Morgenbriefing" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Morgenbriefing.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.Morgenbriefing</item>
    </style>

    <!-- Gemini's Search Suggestions (ui/chat/SearchSuggestions.kt): a WebView reports
         prefers-color-scheme from isLightTheme, so it is created with the scheme the app shows,
         whatever the system and the activity theme say. -->
    <style name="Theme.Morgenbriefing.WebLight" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:isLightTheme" tools:targetApi="q">true</item>
    </style>

    <style name="Theme.Morgenbriefing.WebDark" parent="android:Theme.Material.NoActionBar">
        <item name="android:isLightTheme" tools:targetApi="q">false</item>
    </style>
</resources>
