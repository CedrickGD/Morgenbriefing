<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher icon for Android 7.x (no adaptive icons): round badge + the same artwork. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#FFF7C27A"
                android:centerColor="#FFE58A57"
                android:endColor="#FFC6613F" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
